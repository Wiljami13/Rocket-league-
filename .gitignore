<!DOCTYPE html>
<html lang="fi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rocket Arena 3D</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      overflow: hidden;
      background: #080b14;
      color: #fff;
      font-family: system-ui, sans-serif;
    }
    canvas { display: block; }
    #hud {
      position: fixed;
      inset: 0;
      pointer-events: none;
      text-shadow: 0 2px 6px #000;
    }
    #stats {
      position: absolute;
      top: 18px;
      left: 20px;
      font-size: 18px;
      line-height: 1.6;
    }
    #health-wrap {
      width: 210px;
      height: 14px;
      margin-top: 5px;
      overflow: hidden;
      border: 1px solid #fff9;
      border-radius: 8px;
      background: #250f19;
    }
    #health {
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, #ff3158, #ff9a49);
      transition: width 0.15s;
    }
    #reticle {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 18px;
      height: 18px;
      transform: translate(-50%, -50%);
    }
    #reticle::before, #reticle::after {
      content: "";
      position: absolute;
      background: #fff;
      box-shadow: 0 0 5px #ff5b42;
    }
    #reticle::before { width: 2px; height: 18px; left: 8px; }
    #reticle::after { height: 2px; width: 18px; top: 8px; }
    #message {
      position: absolute;
      left: 50%;
      bottom: 8%;
      transform: translateX(-50%);
      font-size: 16px;
      color: #ffd2a5;
      white-space: nowrap;
    }
    #overlay {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      background: radial-gradient(ellipse, #151d31dd, #05070eee);
      z-index: 2;
    }
    #panel {
      width: min(90vw, 520px);
      padding: 34px;
      border: 1px solid #79d8ff88;
      border-radius: 16px;
      background: #101827ee;
      box-shadow: 0 0 50px #28aaff22;
      text-align: center;
    }
    h1 {
      margin: 0 0 8px;
      color: #8be5ff;
      font-size: clamp(32px, 8vw, 54px);
      letter-spacing: 2px;
    }
    #subtitle { color: #ff9e6d; font-weight: 700; }
    p { color: #d3d9e8; line-height: 1.6; }
    button {
      margin-top: 12px;
      padding: 13px 28px;
      border: 0;
      border-radius: 8px;
      background: linear-gradient(100deg, #16b9e8, #7865ff);
      color: white;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
    }
    button:hover { filter: brightness(1.15); }
  </style>
</head>
<body>
  <div id="hud">
    <div id="stats">
      <div>TERVEYS</div>
      <div id="health-wrap"><div id="health"></div></div>
      <div>Pisteet: <span id="score">0</span></div>
      <div>Aalto: <span id="wave">1</span></div>
      <div>Vastustajia: <span id="enemy-count">0</span></div>
    </div>
    <div id="reticle"></div>
    <div id="message">WASD liikkuu · hiiri tähtää · klikkaa ampuaksesi</div>
  </div>

  <div id="overlay">
    <div id="panel">
      <h1>ROCKET<br>ARENA 3D</h1>
      <div id="subtitle">AREENA ODOTTAA</div>
      <p id="description">
        Selviydy robottivihollisten aalloista ja kerää pisteitä.<br>
        WASD: liiku · hiiri: tähtää · vasen klikkaus: ammu<br>
        Esc: vapauta hiiri ja pysäytä peli.
      </p>
      <button id="start">ALOITA PELI</button>
    </div>
  </div>

  <script type="module">
    import * as THREE from
      "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js";

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x080b14);
    scene.fog = new THREE.Fog(0x080b14, 28, 72);

    const camera = new THREE.PerspectiveCamera(
      75, innerWidth / innerHeight, 0.1, 120
    );
    camera.position.set(0, 1.7, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(innerWidth, innerHeight);
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    document.body.appendChild(renderer.domElement);

    scene.add(new THREE.HemisphereLight(0x9dcaff, 0x25152f, 2));

    const sun = new THREE.DirectionalLight(0xffffff, 2.2);
    sun.position.set(-8, 18, 7);
    sun.castShadow = true;
    sun.shadow.mapSize.set(1024, 1024);
    scene.add(sun);

    const arenaSize = 24;
    const floor = new THREE.Mesh(
      new THREE.PlaneGeometry(arenaSize * 2, arenaSize * 2),
      new THREE.MeshStandardMaterial({
        color: 0x172136, metalness: 0.35, roughness: 0.72
      })
    );
    floor.rotation.x = -Math.PI / 2;
    floor.receiveShadow = true;
    scene.add(floor);

    const grid = new THREE.GridHelper(48, 48, 0x16b9e8, 0x34425c);
    grid.position.y = 0.015;
    scene.add(grid);

    function addWall(x, z, width, depth) {
      const wall = new THREE.Mesh(
        new THREE.BoxGeometry(width, 4, depth),
        new THREE.MeshStandardMaterial({
          color: 0x202c43, metalness: 0.4, roughness: 0.65
        })
      );
      wall.position.set(x, 2, z);
      wall.castShadow = true;
      wall.receiveShadow = true;
      scene.add(wall);
    }

    addWall(0, -24, 48, 1);
    addWall(0, 24, 48, 1);
    addWall(-24, 0, 1, 48);
    addWall(24, 0, 1, 48);

    // Värikkäät areenavalot
    for (const [x, z, color] of [
      [-20, -20, 0x16c9ff], [20, -20, 0xff326e],
      [-20, 20, 0xa264ff], [20, 20, 0xffa332]
    ]) {
      const light = new THREE.PointLight(color, 65, 24);
      light.position.set(x, 3.2, z);
      scene.add(light);

      const orb = new THREE.Mesh(
        new THREE.SphereGeometry(0.35, 16, 12),
        new THREE.MeshBasicMaterial({ color })
      );
      orb.position.copy(light.position);
      scene.add(orb);
    }

    // Areenan suojapilarit
    for (const [x, z] of [
      [-9, -9], [9, -9], [-9, 9], [9, 9], [0, -14], [0, 14]
    ]) {
      const pillar = new THREE.Mesh(
        new THREE.BoxGeometry(1.5, 2.8, 1.5),
        new THREE.MeshStandardMaterial({
          color: 0x35415a, metalness: 0.55, roughness: 0.4
        })
      );
      pillar.position.set(x, 1.4, z);
      pillar.castShadow = true;
      pillar.receiveShadow = true;
      scene.add(pillar);

      const stripe = new THREE.Mesh(
        new THREE.BoxGeometry(1.56, 0.12, 1.56),
        new THREE.MeshBasicMaterial({ color: 0x31d8ff })
      );
      stripe.position.set(x, 2.25, z);
      scene.add(stripe);
    }

    const overlay = document.querySelector("#overlay");
    const startButton = document.querySelector("#start");
    const title = document.querySelector("h1");
    const subtitle = document.querySelector("#subtitle");
    const description = document.querySelector("#description");
    const healthBar = document.querySelector("#health");
    const scoreText = document.querySelector("#score");
    const waveText = document.querySelector("#wave");
    const enemyCountText = document.querySelector("#enemy-count");
    const message = document.querySelector("#message");

    let playing = false;
    let gameOver = false;
    let health = 100;
    let score = 0;
    let wave = 1;
    let lastShot = 0;
    let shotCooldown = 550;
    let yaw = 0;
    let pitch = 0;
    let enemies = [];
    let rockets = [];
    let enemyShots = [];
    let effects = [];
    const keys = new Set();

    const rocketMaterial = new THREE.MeshStandardMaterial({
      color: 0xff8a36, emissive: 0xff3d12, emissiveIntensity: 2
    });
    const enemyShotMaterial = new THREE.MeshBasicMaterial({ color: 0xff3b69 });

    function makeEnemy(x, z) {
      const group = new THREE.Group();
      const body = new THREE.Mesh(
        new THREE.SphereGeometry(0.65, 20, 16),
        new THREE.MeshStandardMaterial({
          color: 0xd83957, metalness: 0.45, roughness: 0.35,
          emissive: 0x350716
        })
      );
      body.position.y = 0.9;
      body.castShadow = true;
      group.add(body);

      const eye = new THREE.Mesh(
        new THREE.BoxGeometry(0.48, 0.13, 0.12),
        new THREE.MeshBasicMaterial({ color: 0x77f4ff })
      );
      eye.position.set(0, 1.02, -0.57);
      group.add(eye);

      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(0.78, 0.07, 8, 24),
        new THREE.MeshBasicMaterial({ color: 0xff4a72 })
      );
      ring.rotation.x = Math.PI / 2;
      ring.position.y = 0.25;
      group.add(ring);

      group.position.set(x, 0, z);
      scene.add(group);

      enemies.push({
        group, hp: 2 + Math.floor(wave / 3),
        speed: 1.5 + Math.random() * 0.6 + wave * 0.08,
        shootTimer: 1 + Math.random() * 2,
        strafe: Math.random() < 0.5 ? -1 : 1
      });
    }

    function spawnWave() {
      const count = Math.min(3 + wave, 12);
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const radius = 13 + Math.random() * 7;
        makeEnemy(
          THREE.MathUtils.clamp(Math.cos(angle) * radius, -20, 20),
          THREE.MathUtils.clamp(Math.sin(angle) * radius, -20, 20)
        );
      }
      waveText.textContent = wave;
      updateHud();
    }

    function updateHud() {
      healthBar.style.width = `${Math.max(0, health)}%`;
      scoreText.textContent = score;
      enemyCountText.textContent = enemies.length;
    }

    function makeExplosion(position, color = 0xffa33b, size = 2.5) {
      const mesh = new THREE.Mesh(
        new THREE.SphereGeometry(0.5, 16, 12),
        new THREE.MeshBasicMaterial({
          color, transparent: true, opacity: 0.8
        })
      );
      mesh.position.copy(position);
      scene.add(mesh);
      effects.push({ mesh, age: 0, duration: 0.28, size });
    }

    function fireRocket() {
      const now = performance.now();
      if (!playing || now - lastShot < shotCooldown) return;
      lastShot = now;

      const direction = new THREE.Vector3();
      camera.getWorldDirection(direction);
      const start = camera.position.clone().addScaledVector(direction, 0.8);
      const rocket = new THREE.Mesh(
        new THREE.SphereGeometry(0.16, 12, 10), rocketMaterial
      );
      rocket.position.copy(start);
      scene.add(rocket);

      const flame = new THREE.PointLight(0xff6a20, 2, 4);
      rocket.add(flame);

      rockets.push({
        mesh: rocket,
        velocity: direction.multiplyScalar(24),
        age: 0
      });
    }

    function explodeRocket(rocket) {
      const position = rocket.mesh.position.clone();
      makeExplosion(position, 0xffa33b, 3.1);

      for (const enemy of [...enemies]) {
        const distance = enemy.group.position.distanceTo(position);
        if (distance < 3.2) {
          enemy.hp -= distance < 1.5 ? 3 : 2;
          if (enemy.hp <= 0) {
            scene.remove(enemy.group);
            enemies = enemies.filter(item => item !== enemy);
            score += 100;
          }
        }
      }

      // Raketin läheltä voi saada pienen omavahingon.
      const selfDistance = camera.position.distanceTo(position);
      if (selfDistance < 2.2) damagePlayer(8);

      scene.remove(rocket.mesh);
      rockets = rockets.filter(item => item !== rocket);
      updateHud();
    }

    function damagePlayer(amount) {
      if (!playing) return;
      health -= amount;
      updateHud();
      if (health <= 0) endGame();
    }

    function endGame() {
      playing = false;
      gameOver = true;
      document.exitPointerLock?.();
      title.innerHTML = "PELI<br>OHI";
      subtitle.textContent = `PISTEET: ${score}`;
      description.textContent =
        `Selvisit aaltoon ${wave}. Kokeile uudelleen ja kerää lisää pisteitä!`;
      startButton.textContent = "PELAA UUDELLEEN";
      overlay.style.display = "grid";
    }

    function resetGame() {
      for (const enemy of enemies) scene.remove(enemy.group);
      for (const item of rockets) scene.remove(item.mesh);
      for (const item of enemyShots) scene.remove(item.mesh);
      for (const item of effects) scene.remove(item.mesh);

      enemies = [];
      rockets = [];
      enemyShots = [];
      effects = [];
      health = 100;
      score = 0;
      wave = 1;
      yaw = 0;
      pitch = 0;
      camera.position.set(0, 1.7, 0);
      camera.rotation.set(0, 0, 0);
      title.innerHTML = "ROCKET<br>ARENA 3D";
      subtitle.textContent = "AREENA ODOTTAA";
      description.innerHTML =
        "Selviydy robottivihollisten aalloista ja kerää pisteitä.<br>" +
        "WASD: liiku · hiiri: tähtää · vasen klikkaus: ammu<br>" +
        "Esc: vapauta hiiri ja pysäytä peli.";
      startButton.textContent = "ALOITA PELI";
      updateHud();
      spawnWave();
    }

    startButton.addEventListener("click", () => {
      if (gameOver) resetGame();
      overlay.style.display = "none";
      playing = true;
      gameOver = false;
      renderer.domElement.requestPointerLock?.();
    });

    document.addEventListener("pointerlockchange", () => {
      if (document.pointerLockElement === renderer.domElement) {
        playing = true;
        overlay.style.display = "none";
      } else if (playing && !gameOver) {
        playing = false;
        title.innerHTML = "PYSÄYTETTY";
        subtitle.textContent = "ROCKET ARENA 3D";
        description.textContent =
          "Peli on pysäytetty. Jatka klikkaamalla alla olevaa painiketta.";
        startButton.textContent = "JATKA";
        overlay.style.display = "grid";
      }
    });

    document.addEventListener("mousemove", event => {
      if (!playing) return;
      yaw -= event.movementX * 0.0022;
      pitch -= event.movementY * 0.0022;
      pitch = THREE.MathUtils.clamp(pitch, -1.35, 1.35);
      camera.rotation.order = "YXZ";
      camera.rotation.set(pitch, yaw, 0);
    });

    document.addEventListener("keydown", event => {
      keys.add(event.code);
      if (["Space", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"]
        .includes(event.code)) event.preventDefault();
    });
    document.addEventListener("keyup", event => keys.delete(event.code));
    document.addEventListener("mousedown", event => {
      if (event.button === 0) fireRocket();
    });
    document.addEventListener("contextmenu", event => event.preventDefault());

    const clock = new THREE.Clock();

    function updatePlayer(dt) {
      const forward = new THREE.Vector3(-Math.sin(yaw), 0, -Math.cos(yaw));
      const right = new THREE.Vector3(Math.cos(yaw), 0, -Math.sin(yaw));
      const movement = new THREE.Vector3();

      if (keys.has("KeyW")) movement.add(forward);
      if (keys.has("KeyS")) movement.sub(forward);
      if (keys.has("KeyD")) movement.add(right);
      if (keys.has("KeyA")) movement.sub(right);

      if (movement.lengthSq() > 0) {
        movement.normalize().multiplyScalar(8 * dt);
        camera.position.add(movement);
      }

      camera.position.x = THREE.MathUtils.clamp(camera.position.x, -22, 22);
      camera.position.z = THREE.MathUtils.clamp(camera.position.z, -22, 22);
      camera.position.y = 1.7;
    }

    function updateEnemies(dt) {
      for (const enemy of enemies) {
        const position = enemy.group.position;
        const toPlayer = new THREE.Vector3(
          camera.position.x - position.x, 0,
          camera.position.z - position.z
        );
        const distance = toPlayer.length();

        if (distance > 4) {
          toPlayer.normalize();
          const side = new THREE.Vector3(-toPlayer.z, 0, toPlayer.x)
            .multiplyScalar(enemy.strafe * 0.35);
          position.addScaledVector(toPlayer.add(side).normalize(),
            enemy.speed * dt);
        } else {
          enemy.strafe *= -1;
        }

        position.x = THREE.MathUtils.clamp(position.x, -21, 21);
        position.z = THREE.MathUtils.clamp(position.z, -21, 21);
        enemy.group.lookAt(camera.position.x, 0, camera.position.z);
        enemy.group.position.y = Math.sin(performance.now() * 0.004 +
          position.x) * 0.08;

        enemy.shootTimer -= dt;
        if (enemy.shootTimer <= 0 && distance < 25) {
          enemy.shootTimer = 1.5 + Math.random() * 1.6;
          const start = position.clone().add(new THREE.Vector3(0, 1, 0));
          const target = camera.position.clone();
          const direction = target.sub(start).normalize();
          const mesh = new THREE.Mesh(
            new THREE.SphereGeometry(0.13, 10, 8), enemyShotMaterial
          );
          mesh.position.copy(start);
          scene.add(mesh);
          enemyShots.push({
            mesh, velocity: direction.multiplyScalar(9 + wave * 0.25),
            age: 0
          });
        }

        if (distance < 1.15) damagePlayer(12 * dt);
      }
    }

    function updateProjectiles(dt) {
      for (const rocket of [...rockets]) {
        rocket.age += dt;
        rocket.mesh.position.addScaledVector(rocket.velocity, dt);

        let hit = rocket.age > 3.5;
        for (const enemy of enemies) {
          if (rocket.mesh.position.distanceTo(
            enemy.group.position.clone().add(new THREE.Vector3(0, 0.9, 0))
          ) < 0.8) {
            hit = true;
            break;
          }
        }

        if (rocket.mesh.position.y < 0.2 || rocket.mesh.position.y > 8 ||
            Math.abs(rocket.mesh.position.x) > 23 ||
            Math.abs(rocket.mesh.position.z) > 23) hit = true;

        if (hit) explodeRocket(rocket);
      }

      for (const shot of [...enemyShots]) {
        shot.age += dt;
        shot.mesh.position.addScaledVector(shot.velocity, dt);

        if (shot.mesh.position.distanceTo(camera.position) < 0.65) {
          damagePlayer(9);
          scene.remove(shot.mesh);
          enemyShots = enemyShots.filter(item => item !== shot);
        } else if (shot.age > 4 ||
          Math.abs(shot.mesh.position.x) > 24 ||
          Math.abs(shot.mesh.position.z) > 24) {
          scene.remove(shot.mesh);
          enemyShots = enemyShots.filter(item => item !== shot);
        }
      }
    }

    function updateEffects(dt) {
      for (const effect of [...effects]) {
        effect.age += dt;
        const progress = effect.age / effect.duration;
        effect.mesh.scale.setScalar(1 + progress * effect.size);
        effect.mesh.material.opacity = Math.max(0, 0.8 * (1 - progress));
        if (progress >= 1) {
          scene.remove(effect.mesh);
          effects = effects.filter(item => item !== effect);
        }
      }
    }

    function animate() {
      requestAnimationFrame(animate);
      const dt = Math.min(clock.getDelta(), 0.05);

      if (playing) {
        updatePlayer(dt);
        updateEnemies(dt);
        updateProjectiles(dt);
        updateEffects(dt);

        if (enemies.length === 0 && !gameOver) {
          wave++;
          spawnWave();
          message.textContent = `Aalto ${wave} alkaa!`;
          setTimeout(() => {
            message.textContent =
              "WASD liikkuu · hiiri tähtää · klikkaa ampuaksesi";
          }, 1800);
        }
        updateHud();
      } else {
        updateEffects(dt);
      }

      renderer.render(scene, camera);
    }

    addEventListener("resize", () => {
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(innerWidth, innerHeight);
    });

    resetGame();
    animate();
  </script>
</body>
</html>
